{
  "cleanUrls": false,
  "trailingSlash": false,

  "headers": [
    {
      "source": "/src/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/src/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/src/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],

  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/disenos",
      "destination": "/index.html"
    },
    {
      "source": "/interior",
      "destination": "/index.html"
    },
    {
      "source": "/conexion",
      "destination": "/index.html"
    },
    {
      "source": "/descargar",
      "destination": "/index.html"
    }
  ]
}